{
  "name": "mercado-frete-pagamentos",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/index.ts --bundle --format=esm --platform=neutral --main-fields=module,main --loader:.json=json --alias:cloudflare:workers=./teste/shim-workers.mjs --outfile=.teste/worker.mjs --log-level=warning && node --no-warnings --test teste/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "~6.0.3",
    "wrangler": "4.150.0"
  }
}
